# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 18 via Coolify)
DATABASE_URL=postgresql://nghome:password@localhost:5432/nghome

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Security
BCRYPT_ROUNDS=12
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Storage (local by default; configure for S3/R2/MinIO in production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# S3-compatible (future use)
# STORAGE_BUCKET=nghome-uploads
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=https://your-endpoint
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key

# SFTP (used by POST /documents/upload — the actual document storage backend today)
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
# Either SFTP_PASSWORD or SFTP_PRIVATE_KEY — a key is preferred where the server supports it.
SFTP_PASSWORD=
# SFTP_PRIVATE_KEY=
SFTP_BASE_PATH=/ng-home-documents

# Swagger (disable in production)
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Email / SMTP (password reset)
# These are the fallback. A mail login saved in the platform console (Settings →
# Email server) wins over them and takes effect without a redeploy; its password
# is encrypted with SETTINGS_ENCRYPTION_KEY, or JWT_ACCESS_SECRET when that is
# unset. Once chosen, do not change the key or the saved password must be retyped.
# SETTINGS_ENCRYPTION_KEY=a-long-random-string
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Leave SMTP_FROM unset to send as the SMTP_USER mailbox (safest: servers only
# relay for senders they own). If set, use an address on your own domain.
# SMTP_FROM=NG Home <no-reply@yourdomain.com>
# URL of the web frontend — appended to reset links in emails
APP_URL=http://localhost:3001

# Platform admin bootstrap (used only on first run seed)
PLATFORM_ADMIN_EMAIL=admin@novagade.in
PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# WhatsApp automation (bill published, reminders, late fine, payment received).
# Sent through OpenWA, a self-hosted WhatsApp gateway (see docs/whatsapp-automation.md). Only the gateway's address and key are set here
# (normally in the app: Platform console → Settings → WhatsApp messages, which wins over these). Each society links its own
# number as its own session on the gateway, so there is no session id to configure here;
# they are only a fallback. Leave both empty to
# keep the feature off; a society also has to switch it on in Settings.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
# Optional: pause between two messages (ms, random in this range), and the most messages sent in a day.
# WHATSAPP_SEND_GAP_MIN_MS=6000
# WHATSAPP_SEND_GAP_MAX_MS=14000
# WHATSAPP_DAILY_CAP=250
# WHATSAPP_JOB=off   # stops the background sender and reminder job on this server
