// ─── EVENTS ───────────────────────────────────────────────────────────────────
//
// Covers both society events (Diwali celebration, AGM) and admin-planned
// upcoming activities with a known or estimated cost (AMC servicing, water
// tank cleaning) — same shape either way: a title, a date, and an optional
// cost. estimatedCost is set at planning time; actualCost is filled in once
// it's known. Linking to a Fund is optional and purely informational — it
// does not move money; any real spend still goes through Expense.

model Event {
  id                   String      @id @default(uuid())
  societyId            String
  title                String
  description          String?
  eventDate            DateTime
  fundId               String?
  estimatedCost        Decimal?    @db.Decimal(12, 2)
  actualCost           Decimal?    @db.Decimal(12, 2)
  status               EventStatus @default(PLANNED)
  isVisibleToResidents Boolean     @default(true)
  createdById          String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  fund      Fund?   @relation(fields: [fundId], references: [id], onDelete: SetNull)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([societyId])
  @@index([eventDate])
  @@map("events")
}

// ─── DOCUMENTS ────────────────────────────────────────────────────────────────

model Document {
  id               String              @id @default(uuid())
  societyId        String
  // Set only for FLAT_PRIVATE documents — which flat this belongs to.
  // Visibility is keyed on the viewer's own flatId matching this, not on
  // role, so an admin who also resides at this exact flat (a membership
  // can carry both a role and a flatId) can still see it like any other
  // resident there would; nobody else, including other admins, can.
  flatId           String?
  title            String
  description      String?
  fileName         String
  fileKey          String
  fileSize         Int
  mimeType         String
  storageProvider  String              @default("local")
  accessLevel      DocumentAccessLevel @default(RESIDENTS_ONLY)
  category         String?
  linkedEntityType String?
  linkedEntityId   String?
  uploadedById     String
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  society       Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat          Flat?               @relation(fields: [flatId], references: [id], onDelete: Cascade)
  uploadedBy    User                @relation(fields: [uploadedById], references: [id])
  expenses      Expense[]           @relation("ExpenseDocuments")
  payments      PaymentSubmission[] @relation("PaymentDocuments")
  announcements Announcement[]      @relation("AnnouncementDocuments")
  meetings      Meeting[]           @relation("MeetingDocuments")

  @@index([societyId])
  @@index([flatId])
  @@map("documents")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id             String                @id @default(uuid())
  societyId      String
  title          String
  body           String
  type           String
  data           Json                  @default("{}")
  channels       NotificationChannel[]
