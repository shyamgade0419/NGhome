// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model PaymentSubmission {
  id                String        @id @default(uuid())
  societyId         String
  flatId            String
  userId            String
  maintenanceBillId String?
  billingPeriodId   String?
  amount            Decimal       @db.Decimal(12, 2)
  paymentDate       DateTime
  paymentMethod     PaymentMethod
  referenceNumber   String?
  utrNumber         String?
  bankName          String?
  chequeNumber      String?
  notes             String?
  status            PaymentStatus @default(PENDING)
  reviewedAt        DateTime?
  reviewedById      String?
  reviewNotes       String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  transactionId     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  flat            Flat             @relation(fields: [flatId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  maintenanceBill MaintenanceBill? @relation(fields: [maintenanceBillId], references: [id])
  documents       Document[]       @relation("PaymentDocuments")
  allocations     PaymentAllocation[]

  // A UTR is a real bank-assigned reference for one specific transaction —
  // the same (flat, UTR) pair can only ever mean the same payment
  // resubmitted (a network retry after tapping Submit twice), never two
  // legitimate payments. NULL utrNumber values (cash/cheque payments) are
  // never considered equal to each other by Postgres, so this never blocks
  // those. See PaymentsService.submit.
  @@unique([flatId, utrNumber])
  // approve()/submit()'s auto-approve path both only ever set transactionId
  // once per payment, guarded by an atomic conditional status transition
  // (PENDING/UNDER_REVIEW -> APPROVED can happen at most once per row) — so
  // this constraint should never reject a legitimate write. It exists as a
  // second, database-level guarantee that a Transaction is never linked to
  // more than one payment, independent of the application logic staying
  // correct. NULL (every non-approved payment) is never considered equal to
  // another NULL by Postgres, so this never blocks PENDING/REJECTED rows.
  @@unique([transactionId])
  @@index([societyId])
  @@index([flatId])
  @@index([userId])
  @@map("payment_submissions")
}

// ─── MONTHLY STATEMENT ────────────────────────────────────────────────────────

model MonthlyStatement {
