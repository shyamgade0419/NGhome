  actor   User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([societyId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── HELPDESK ─────────────────────────────────────────────────────────────────

model MaintenanceRequest {
  id           String                   @id @default(uuid())
  societyId    String
  flatId       String?
  residentId   String
  assignedToId String?
  title        String
  description  String?
  category     MaintenanceCategory      @default(OTHER)
  priority     MaintenancePriority      @default(MEDIUM)
  status       MaintenanceRequestStatus @default(OPEN)
  adminNotes   String?
  resolvedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  society    Society                     @relation(fields: [societyId], references: [id])
  flat       Flat?                       @relation(fields: [flatId], references: [id])
  resident   User                        @relation("RequestSubmitter", fields: [residentId], references: [id])
  assignedTo User?                       @relation("RequestAssignee", fields: [assignedToId], references: [id])
  comments   MaintenanceRequestComment[]

  @@index([societyId])
  @@index([residentId])
  @@index([status])
  @@map("maintenance_requests")
}

// A reply on a helpdesk request. Tickets were one-way: a resident raised one
// and could only watch the status change, with a single adminNotes field as
// the only channel back. Either side can now post, visible to both — the
// resident who raised it and the society's staff. Deliberately no internal /
// staff-only flag yet: adminNotes still serves that purpose, and a hidden
// channel inside a conversation the resident believes is complete is worth a
// separate decision.
model MaintenanceRequestComment {
  id        String   @id @default(uuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User               @relation("RequestCommentAuthor", fields: [authorId], references: [id])

  @@index([requestId, createdAt])
  @@map("maintenance_request_comments")
}

// ─── COMMUNITY FORUM ──────────────────────────────────────────────────────────
//
// Any active member of a society can start a topic and reply to one — unlike
// Announcement (admin/staff-authored, one-way broadcast), a forum topic can be
// raised by any resident. isPinned/isLocked are moderation-only: only an
// admin/committee member can set them (enforced in ForumService, not here).

model ForumTopic {
  id          String   @id @default(uuid())
  societyId   String
  createdById String
  title       String
  body        String
  isPinned    Boolean  @default(false)
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  society   Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  createdBy User         @relation("ForumTopicCreator", fields: [createdById], references: [id])
  replies   ForumReply[]

  @@index([societyId])
  @@index([societyId, isPinned, createdAt])
  @@map("forum_topics")
}

model ForumReply {
  id        String   @id @default(uuid())
  topicId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  topic  ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User       @relation("ForumReplyAuthor", fields: [authorId], references: [id])

  @@index([topicId, createdAt])
  @@map("forum_replies")
}

// ─── DIRECT MESSAGING ─────────────────────────────────────────────────────────
//
// Resident-to-resident chat, refresh-based rather than a live socket — a
// message is a normal row the recipient's client picks up on its next poll,
// with a push notification (existing NotificationsService) so they know to
// look. One Conversation per pair of participants within a society;
// ConversationParticipant is a join table (rather than two nullable user
// columns on Conversation) so this can hold more than two participants later
// without a schema change. lastReadAt is a per-participant marker, not a
// read flag per message — unread counts are derived by comparing each
// message's createdAt against it, which scales to more than two people and
// needs no write on every single message read.

model Conversation {
  id        String   @id @default(uuid())
  societyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society      Society                   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([societyId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model DirectMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

// ─── PLATFORM SETTINGS ────────────────────────────────────────────────────────

/// One row (id "singleton") of platform-wide switches the NovaGade team sets
/// from the console: whether the product is free, and the optional "support
/// the developer" UPI details shown to users. Not tenant data.
model PlatformSettings {
  id               String   @id @default("singleton")
  pricingMode      String   @default("FREE") // FREE | PAID — PAID is recorded only; nothing enforces it yet
  supportEnabled   Boolean  @default(false)
  supportUpiId     String?
  supportPayeeName String?
  supportMessage   String?
  updatedById      String?
  updatedAt        DateTime @updatedAt

  @@map("platform_settings")
}

/// The outgoing-mail login, set from the platform console instead of the server's
/// environment. One row (id "singleton"). When it has a host it wins over the
/// SMTP_* environment variables; deleting the row falls back to them. The
/// password is encrypted (AES-256-GCM) and never sent back to any client.
model PlatformMailSettings {
  id          String   @id @default("singleton")
  host        String
  port        Int
  username    String?
  passwordEnc String?
  fromAddress String?
  fromName    String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_mail_settings")
}

// ─── AMENITY BOOKING ──────────────────────────────────────────────────────────

enum AmenityBookingMode {
  INSTANT
  NEEDS_APPROVAL
}

enum AmenityBookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum AmenityFeeStatus {
  NONE
  DUE
  COLLECTED
  WAIVED
}

/// A shared space residents can book — clubhouse, hall, court, gym. Opening
/// hours are minutes since midnight in India Standard Time (the product is
/// India-only and IST has no daylight saving), so a slot is never ambiguous.
model Amenity {
  id                 String             @id @default(uuid())
  societyId          String
  name               String
  description        String?
  rules              String?
  bookingMode        AmenityBookingMode @default(INSTANT)
  slotMinutes        Int                @default(60)
  opensAtMin         Int                @default(360)
  closesAtMin        Int                @default(1320)
  maxAdvanceDays     Int                @default(30)
  monthlyCapPerFlat  Int?
  cancelBeforeHours  Int                @default(24)
  /// How many bookings may overlap one slot (1 = exclusive use).
  capacity           Int                @default(1)
  maxSlotsPerBooking Int                @default(1)
  fee                Decimal?           @db.Decimal(12, 2)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  society  Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  bookings AmenityBooking[]

  @@index([societyId])
  @@map("amenities")
}

model AmenityBooking {
  id                 String               @id @default(uuid())
  societyId          String
  amenityId          String
  flatId             String
  userId             String
  startAt            DateTime
  endAt              DateTime
  status             AmenityBookingStatus
  guestCount         Int                  @default(0)
  note               String?
  /// Snapshot of the amenity's fee when booked, so a later fee change does
  /// not rewrite what this booking owes.
  feeAmount          Decimal              @default(0) @db.Decimal(12, 2)
  feeStatus          AmenityFeeStatus     @default(NONE)
  decidedById        String?
  decidedAt          DateTime?
  rejectionReason    String?
  cancelledAt        DateTime?
  cancelledById      String?
  collectedAccountId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  flat    Flat    @relation(fields: [flatId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([amenityId, startAt])
  @@index([societyId, status])
  @@index([flatId])
  @@index([userId])
  @@map("amenity_bookings")
}

// ─── Visitor and gate management ─────────────────────────────────────────────

enum VisitorType {
  GUEST
  CAB
  DELIVERY
  SERVICE
  OTHER
}

enum VisitorEntryStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHECKED_IN
  CHECKED_OUT
  EXPIRED
}

enum VisitorInvitationStatus {
  ACTIVE
  REVOKED
}

/// A resident's pre-approval of a guest. The code that unlocks it is shown once
/// and only its hash is stored; usedCount and the validity window are enforced
/// by one atomic update at the gate, so a code cannot be replayed.
model VisitorInvitation {
  id           String                  @id @default(uuid())
  societyId    String
  flatId       String
  createdById  String
  visitorName  String
  visitorPhone String?
  visitorType  VisitorType             @default(GUEST)
  note         String?
  validFrom    DateTime
  validUntil   DateTime
  maxUses      Int                     @default(1)
  usedCount    Int                     @default(0)
  codeHash     String                  @unique
  status       VisitorInvitationStatus @default(ACTIVE)
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  society Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat           @relation(fields: [flatId], references: [id], onDelete: Cascade)
  entries VisitorEntry[]

  @@index([societyId, flatId, status])
  @@index([createdById])
  @@map("visitor_invitations")
}

/// One visit: arrival at the gate, the resident's decision, entry and exit.
/// clientRequestId makes a guard's retried submission safe.
model VisitorEntry {
  id              String             @id @default(uuid())
  societyId       String
  flatId          String
  invitationId    String?
  visitorName     String
  visitorPhone    String?
  visitorType     VisitorType        @default(GUEST)
  vehicleNumber   String?
  purpose         String?
  status          VisitorEntryStatus @default(PENDING_APPROVAL)
  requestedAt     DateTime           @default(now())
  registeredById  String?
  decidedAt       DateTime?
  decidedById     String?
  decisionNote    String?
  /// RESIDENT | POLICY | INVITATION | ADMIN_OVERRIDE | EXPECTATION
  decisionMethod  String?
  checkedInAt     DateTime?
  checkedInById   String?
  checkedOutAt    DateTime?
  checkedOutById  String?
  clientRequestId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  society    Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat       Flat               @relation(fields: [flatId], references: [id], onDelete: Cascade)
  invitation VisitorInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@unique([societyId, clientRequestId])
  @@index([societyId, requestedAt])
  @@index([flatId, requestedAt])
  @@index([societyId, status])
  @@map("visitor_entries")
}

// ─── Deliveries ──────────────────────────────────────────────────────────────

enum DeliveryInstruction {
  /// The delivery person may come up: the gate lets the next delivery for this flat in without asking.
  ALLOW_ENTRY
  /// Do not send them up: the guard receives the parcel and keeps it at the gate.
  LEAVE_AT_GATE
}

enum DeliveryExpectationStatus {
  ACTIVE
  CANCELLED
}

enum ParcelStatus {
  RECEIVED
  COLLECTED
  RETURNED
}

/// A resident's standing answer to "a delivery is coming": let them up, or leave
/// it at the gate. Time-limited and use-limited; ALLOW_ENTRY is spent by one
/// atomic update when the gate registers a delivery for the flat.
model DeliveryExpectation {
  id          String                    @id @default(uuid())
  societyId   String
  flatId      String
  createdById String
  company     String
  instruction DeliveryInstruction
  note        String?
  validFrom   DateTime
  validUntil  DateTime
  maxUses     Int                       @default(1)
  usedCount   Int                       @default(0)
  status      DeliveryExpectationStatus @default(ACTIVE)
  cancelledAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat    @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([societyId, flatId, status])
  @@index([societyId, validUntil])
  @@map("delivery_expectations")
}

/// A parcel the gate is holding for a flat, from receipt to hand-over or return.
/// clientRequestId makes a guard's retried submission safe.
model Parcel {
  id              String       @id @default(uuid())
  societyId       String
  flatId          String
  courier         String
  recipientName   String?
  note            String?
  status          ParcelStatus @default(RECEIVED)
  receivedAt      DateTime     @default(now())
  receivedById    String?
  closedAt        DateTime?
  closedById      String?
  /// Who physically took it (typed by the guard), when handed over.
  collectedByName String?
  clientRequestId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat    @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@unique([societyId, clientRequestId])
  @@index([societyId, status])
  @@index([flatId, receivedAt])
  @@index([societyId, receivedAt])
  @@map("parcels")
}

// ─── Domestic help ───────────────────────────────────────────────────────────

enum HelperRole {
  MAID
  COOK
  DRIVER
  NANNY
  CLEANER
  GARDENER
  OTHER
}

enum HelperStatus {
  ACTIVE
  SUSPENDED
}

/// Someone who works in the society's homes (a maid, cook, driver…). One record
/// per person per society: the same person working for several flats is linked
/// to each flat, found by phone number. The pass code the guard can check is
/// shown once and only its hash is stored.
model DomesticHelper {
  id              String       @id @default(uuid())
  societyId       String
  name            String
  /// Digits only, India country code removed. Unique per society when present.
  phone           String?
  role            HelperRole   @default(MAID)
  status          HelperStatus @default(ACTIVE)
  codeHash        String       @unique
  createdById     String
  /// A committee member confirmed who this person is.
  verifiedAt      DateTime?
  verifiedById    String?
  suspendedAt     DateTime?
  suspendedById   String?
  suspendedReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  society Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flats   DomesticHelperFlat[]
  visits  DomesticHelperVisit[]

  @@unique([societyId, phone])
  @@index([societyId, status])
  @@map("domestic_helpers")
}

/// A flat the helper works for. Removing a flat ends the link without erasing the history.
model DomesticHelperFlat {
  id        String   @id @default(uuid())
  societyId String
  helperId  String
  flatId    String
  addedById String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  helper DomesticHelper @relation(fields: [helperId], references: [id], onDelete: Cascade)
  flat   Flat           @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@unique([helperId, flatId])
  @@index([societyId, flatId, active])
  @@map("domestic_helper_flats")
}

/// One stay inside the society: in at the gate, out at the gate. At most one is
/// open per helper (a partial unique index in the migration enforces it).
/// autoClosed marks a stay whose exit was never recorded.
model DomesticHelperVisit {
  id              String    @id @default(uuid())
  societyId       String
  helperId        String
  checkedInAt     DateTime  @default(now())
  checkedInById   String?
  /// CODE | GUARD
  method          String
  checkedOutAt    DateTime?
  checkedOutById  String?
  autoClosed      Boolean   @default(false)
  clientRequestId String?
  createdAt       DateTime  @default(now())

  society Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  helper  DomesticHelper @relation(fields: [helperId], references: [id], onDelete: Cascade)

  @@unique([societyId, clientRequestId])
  @@index([societyId, checkedInAt])
  @@index([helperId, checkedInAt])
  @@map("domestic_helper_visits")
}

// ─── Vehicles and parking ────────────────────────────────────────────────────

enum VehicleKind {
  CAR
  TWO_WHEELER
  CYCLE
  OTHER
}

/// What a parking slot is meant for.
enum SlotFor {
  CAR
  TWO_WHEELER
  ANY
}

/// A vehicle a household has registered. plate is the number reduced to upper-case letters and
/// digits, so "ts 09 ab-1234" and "TS09AB1234" are the same vehicle. A plate may be live on one
/// flat only (a partial unique index in the migration); a removed vehicle keeps its history and
/// frees the plate.
model Vehicle {
  id            String      @id @default(uuid())
  societyId     String
  flatId        String
  plate         String
  kind          VehicleKind
  make          String?
  colour        String?
  active        Boolean     @default(true)
  createdById   String
  removedAt     DateTime?
  removedById   String?
  removedReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  society Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)
  slots   ParkingSlot[]

  @@index([societyId, flatId, active])
  @@index([societyId, plate])
  @@map("vehicles")
}

/// A parking space. Allocated to at most one flat; the flat may say which of its vehicles
/// uses it. A visitor slot is never allocated to a flat.
model ParkingSlot {
  id            String    @id @default(uuid())
  societyId     String
  code          String
  area          String?
  slotFor       SlotFor   @default(ANY)
  visitor       Boolean   @default(false)
  flatId        String?
  vehicleId     String?
  allocatedAt   DateTime?
  allocatedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  society Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat?    @relation(fields: [flatId], references: [id], onDelete: SetNull)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([societyId, code])
  @@index([societyId, flatId])
  @@map("parking_slots")
}

// ─── Staff attendance, shifts and duty roster ────────────────────────────────

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  LEAVE
}

/// A named working period the society uses, e.g. Morning 06:00-14:00. Minutes since midnight,
/// India time. end before start means the shift runs past midnight. Shifts are deactivated, never
/// deleted, so history keeps its meaning.
model StaffShift {
  id          String   @id @default(uuid())
  societyId   String
  name        String
  startMinute Int
  endMinute   Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  society Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  roster  StaffRoster[]

  @@unique([societyId, name])
  @@map("staff_shifts")
}

/// The duty roster: who works which shift on which date, and where. A row with no shift is a
/// scheduled day off.
model StaffRoster {
  id           String   @id @default(uuid())
  societyId    String
  employeeId   String
  date         DateTime @db.Date
  shiftId      String?
  post         String?
  assignedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  society  Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  employee SocietyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    StaffShift?     @relation(fields: [shiftId], references: [id], onDelete: NoAction)

  @@unique([employeeId, date])
  @@index([societyId, date])
  @@map("staff_roster")
}

/// What actually happened on a date. At most one row per employee per day. The guard's check-in
/// and check-out fill the times; the committee can mark any status and correct a day.
model StaffAttendance {
  id             String           @id @default(uuid())
  societyId      String
  employeeId     String
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  checkInAt      DateTime?
  checkOutAt     DateTime?
  checkedInById  String?
  checkedOutById String?
  markedById     String?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  society  Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  employee SocietyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([societyId, date])
  @@map("staff_attendance")
}

// How an approved payment was shared across the flat's bills — oldest dues first. One payment can
// settle several months; the rows add up to the payment.
model PaymentAllocation {
  id        String   @id @default(uuid())
  societyId String
  paymentId String
  billId    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  payment PaymentSubmission @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    MaintenanceBill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([billId])
  @@index([societyId])
  @@map("payment_allocations")
}

// Every movement of a flat's advance credit: money paid ahead of what was owed (positive), and the same
// money used up against a bill (negative). The entries add up to Flat.creditBalance.
model FlatCreditEntry {
  id        String   @id @default(uuid())
  societyId String
  flatId    String
  // + paid ahead   - used against a bill
  amount    Decimal  @db.Decimal(12, 2)
  kind      String   // ADVANCE_PAYMENT | APPLIED_TO_BILL
  paymentId String?
  billId    String?
  createdAt DateTime @default(now())

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([flatId])
  @@index([billId])
  @@index([societyId])
  @@map("flat_credit_entries")
}
