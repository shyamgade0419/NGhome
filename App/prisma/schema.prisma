  totalWaterExpense Decimal   @default(0) @db.Decimal(15, 2)
  otherExpenses     Decimal   @default(0) @db.Decimal(15, 2)
  content           Json      @default("{}")
  isPublished       Boolean   @default(false)
  publishedAt       DateTime?
  publishedById     String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  society       Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id])

