  salaryRecords SalaryRecord[]
  roster        StaffRoster[]
  attendance    StaffAttendance[]

  @@index([societyId])
  @@map("society_employees")
}

model SalaryRecord {
  id               String       @id @default(uuid())
  societyId        String
  employeeId       String
  accountId        String?
  salaryMonth      Int
  salaryYear       Int
  baseSalary       Decimal      @db.Decimal(10, 2)
  additions        Decimal      @default(0) @db.Decimal(10, 2)
