generator client {
  provider      = "prisma-client-js"
  // Explicit targets so Prisma downloads the right binary for Alpine (musl + OpenSSL 3.x).
  // Without this, auto-detection may select `linux-musl` (static) which can fail to dlopen
  // on newer Alpine images, causing Prisma to fall back to the WASM engine and throw
  // "URL must start with prisma://" at startup.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum SystemRole {
  PLATFORM_ADMIN
  SOCIETY_ADMIN
  SOCIETY_ACCOUNTANT
  SOCIETY_STAFF
  RESIDENT
  COMMITTEE_MEMBER
  // Operates the gate only: registers visitors, checks invitation codes, records
  // entry and exit. No access to billing, residents or documents.
  SECURITY_GUARD
}

// Whether a resident owns the flat or rents it. Tenants do not see the corpus or bank balances.
enum ResidencyType {
  OWNER
  TENANT
}

enum BillingCycleType {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum CalculationType {
  EQUAL_PER_FLAT
  AREA_BASED
  PER_PERSON
  HYBRID
  FIXED_CUSTOM
  PERCENTAGE_BASED
  WATER_USAGE_BASED
  CUSTOM_FORMULA
}

enum BillingPeriodStatus {
  DRAFT
  CALCULATED
  REVIEW
  PUBLISHED
  PARTIALLY_PAID
  PAID
  CLOSED
}

// REGULAR is a month's billing. OPENING holds the dues a flat carried over from before it moved to NG Home
// (paper or Excel): one per society, its bills settle and show as arrears like any other.
enum BillingPeriodKind {
  REGULAR
  OPENING
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CASH
  CHEQUE
  NEFT
  RTGS
  IMPS
  OTHER
}

enum AccountType {
  SAVINGS
  CURRENT
  FIXED_DEPOSIT
  CASH
  OTHER
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum SalaryStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementAudience {
  ALL_RESIDENTS
  BUILDING
  BLOCK
  SPECIFIC_FLATS
  COMMITTEE
  STAFF
  ALL
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum DocumentAccessLevel {
  PUBLIC
  RESIDENTS_ONLY
  ADMIN_ONLY
  COMMITTEE_ONLY
  // Visible only to active memberships whose flatId matches the
  // document's own flatId — not even other admins can see it. Documents
  // with this level always carry a flatId; see the Document model.
  FLAT_PRIVATE
}

enum WaterBillingModel {
  PER_LITRE
  PER_KL
  FIXED_CHARGE
  SLAB_BASED
  FIXED_PLUS_USAGE
  SOCIETY_ALLOCATION
  CUSTOM
}

enum FlatStatus {
  ACTIVE
  VACANT
  UNDER_RENOVATION
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum AuditAction {
  LOGIN
  LOGOUT
  USER_CREATED
  USER_MODIFIED
  USER_DEACTIVATED
  USER_DELETED
  BILL_GENERATED
  BILL_MODIFIED
  BILL_PUBLISHED
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  EXPENSE_CREATED
  EXPENSE_MODIFIED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  ACCOUNT_TRANSACTION
  FUND_TRANSACTION
  CONFIG_CHANGED
  PERIOD_CLOSED
  DOCUMENT_DELETED
  COMPLAINT_STATUS_CHANGED
  OTHER
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  CIVIL
  CLEANING
  SECURITY
  ELEVATOR
  CARPENTRY
  PEST_CONTROL
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum EventStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

// ─── USER & AUTH ──────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  firstName       String
  lastName        String
  isActive        Boolean   @default(true)
  isPlatformAdmin Boolean   @default(false)
  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  memberships          SocietyMembership[]
  auditLogs            AuditLog[]                  @relation("AuditActor")
  notificationRecords  NotificationRecord[]
  paymentSubmissions   PaymentSubmission[]
  createdExpenses      Expense[]                   @relation("ExpenseCreator")
  approvedExpenses     Expense[]                   @relation("ExpenseApprover")
  createdAnnouncements Announcement[]
  createdMeetings      Meeting[]
  uploadedDocuments    Document[]
  submittedRequests    MaintenanceRequest[]        @relation("RequestSubmitter")
  assignedRequests     MaintenanceRequest[]        @relation("RequestAssignee")
  requestComments      MaintenanceRequestComment[] @relation("RequestCommentAuthor")
  createdEvents        Event[]
  pushTokens           PushToken[]
  createdForumTopics   ForumTopic[]                @relation("ForumTopicCreator")
  forumReplies         ForumReply[]                @relation("ForumReplyAuthor")
  sentMessages         DirectMessage[]             @relation("MessageSender")
  conversations        ConversationParticipant[]
  amenityBookings      AmenityBooking[]

  @@map("users")
}

model RefreshToken {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  // JWT payload context — stored so rotation works without decoding the opaque token
  societyId    String?
  membershipId String?
  role         String?
  flatId       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// One row per device the app is (or was) installed on — a user can have
// several (phone + tablet, or a reinstall that got a fresh token before
// the old one expired). `token` is the whole identity of a device
// registration: unique globally, so re-registering the same device (app
// restart, re-login, reinstall reusing the same Expo push token) upserts
// onto the existing row and re-points it at whoever's currently logged in,
// rather than accumulating stale duplicates pointed at a previous user of
// a shared/handed-down device.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ─── SOCIETY STRUCTURE ────────────────────────────────────────────────────────

model Society {
  id                  String    @id @default(uuid())
  name                String
  displayName         String?
  registrationNumber  String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  country             String    @default("India")
  email               String?
  phone               String?
  website             String?
  logoUrl             String?
  isActive            Boolean   @default(true)
  // Resident self-registration via join code
  joinCode            String?   @unique
  joinCodeGeneratedAt DateTime?
  // The society's storage folder name, e.g. "chaitanya-classic-3-a1b2c3d4" —
  // set once, on first file upload after this column shipped, and never
  // recomputed from a later name change (StoragePathService.resolveSegment).
  // Files already on disk before that stay under this society's raw id
  // forever; only new uploads move to this folder.
  storageSlug         String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  configuration        SocietyConfiguration?
  buildings            Building[]
  memberships          SocietyMembership[]
  billingRules         BillingRule[]
  billingPeriods       BillingPeriod[]
  accounts             Account[]
  funds                Fund[]
  expenses             Expense[]
  expenseCategories    ExpenseCategory[]
  employees            SocietyEmployee[]
  announcements        Announcement[]
  meetings             Meeting[]
  documents            Document[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  statements           MonthlyStatement[]
  waterConfigs         WaterBillingConfig[]
  transactions         Transaction[]
  maintenanceRequests  MaintenanceRequest[]
  events               Event[]
  forumTopics          ForumTopic[]
  conversations        Conversation[]
  amenities            Amenity[]
  amenityBookings      AmenityBooking[]
  visitorInvitations   VisitorInvitation[]
  visitorEntries       VisitorEntry[]
  deliveryExpectations DeliveryExpectation[]
  parcels              Parcel[]
  domesticHelpers      DomesticHelper[]
  domesticHelperVisits DomesticHelperVisit[]
  vehicles             Vehicle[]
  parkingSlots         ParkingSlot[]
  staffShifts          StaffShift[]
  staffRoster          StaffRoster[]
  staffAttendance      StaffAttendance[]

  @@map("societies")
}

model SocietyConfiguration {
  id                             String           @id @default(uuid())
  societyId                      String           @unique
  currency                       String           @default("INR")
  financialYearStartMonth        Int              @default(4)
  billingCycle                   BillingCycleType @default(MONTHLY)
  billingDueDay                  Int              @default(10)
  gracePeriodDays                Int              @default(5)
  lateFeeType                    String?
  lateFeeValue                   Decimal?         @db.Decimal(10, 2)
  lateFeeMaxAmount               Decimal?         @db.Decimal(10, 2)
  roundingRule                   String           @default("NEAREST")
  invoicePrefix                  String           @default("INV")
  invoiceStartNumber             Int              @default(1)
  invoiceCurrentNumber           Int              @default(1)
  paymentVerificationRequired    Boolean          @default(true)
  allowPaymentProofUpload        Boolean          @default(true)
  // Gates the total bank-account balance on the resident finances screen. Fund
  // visibility is per-fund (Fund.isVisibleToResidents), deliberately not this.
  showAccountBalancesToResidents Boolean          @default(false)
  showExpensesToResidents        Boolean          @default(false)
  publishStatementToResidents    Boolean          @default(true)
  publishMeetingMinutes          Boolean          @default(true)
  notificationChannels           Json             @default("[]")
  additionalConfig               Json             @default("{}")
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@map("society_configurations")
}

model Building {
  id          String    @id @default(uuid())
  societyId   String
  name        String
  code        String?
  description String?
  totalFloors Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  floors  Floor[]
  flats   Flat[]

  @@unique([societyId, code])
  @@index([societyId])
  @@map("buildings")
}

model Floor {
  id         String   @id @default(uuid())
  buildingId String
  number     Int
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  flats    Flat[]

  @@unique([buildingId, number])
  @@index([buildingId])
  @@map("floors")
}

model Flat {
  id             String     @id @default(uuid())
  societyId      String
  buildingId     String
  floorId        String?
  unitNumber     String
  flatCode       String
  area           Decimal?   @db.Decimal(10, 2)
  bedrooms       Int?
  bathrooms      Int?
  category       String?
  status         FlatStatus @default(ACTIVE)
  ownershipType  String?
  parkingSlots   Int        @default(0)
  // The water meter counts down (a fault in the meter): consumption is earlier minus later.
  waterMeterReversed Boolean @default(false)
  // Money the flat has paid ahead of what it owed. Applied to its next bill when that is published.
  // Never below zero (a CHECK in the migration); FlatCreditEntry is its ledger.
  creditBalance Decimal @default(0) @db.Decimal(12, 2)
  additionalInfo Json       @default("{}")
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  building             Building              @relation(fields: [buildingId], references: [id])
  floor                Floor?                @relation(fields: [floorId], references: [id])
  memberships          SocietyMembership[]
  maintenanceBills     MaintenanceBill[]
  waterReadings        WaterMeterReading[]
  paymentSubmissions   PaymentSubmission[]
  maintenanceRequests  MaintenanceRequest[]
  documents            Document[]
  amenityBookings      AmenityBooking[]
  visitorInvitations   VisitorInvitation[]
  visitorEntries       VisitorEntry[]
  deliveryExpectations DeliveryExpectation[]
  parcels              Parcel[]
  domesticHelperFlats  DomesticHelperFlat[]
  vehicles             Vehicle[]
  parkingSlotsHeld     ParkingSlot[]
  creditEntries        FlatCreditEntry[]

  @@unique([societyId, flatCode])
  @@index([societyId])
  @@index([buildingId])
  @@map("flats")
}

model SocietyMembership {
  id                    String           @id @default(uuid())
  societyId             String
  userId                String
  flatId                String?
  role                  SystemRole       @default(RESIDENT)
  status                MembershipStatus @default(ACTIVE)
  joinedAt              DateTime         @default(now())
  leftAt                DateTime?
  isPrimary             Boolean          @default(false)
  // Owner or tenant. Existing members are owners until the admin says otherwise.
  residencyType         ResidencyType    @default(OWNER)
  additionalPermissions Json             @default("[]")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  flat    Flat?   @relation(fields: [flatId], references: [id])

  @@unique([societyId, userId, flatId])
  @@index([societyId])
  @@index([userId])
  @@map("society_memberships")
}

// ─── BILLING ENGINE ───────────────────────────────────────────────────────────

model BillingRule {
  id              String          @id @default(uuid())
  societyId       String
  name            String
  description     String?
  calculationType CalculationType
  isActive        Boolean         @default(true)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  priority        Int             @default(0)
  config          Json            @default("{}")
  applicableTo    Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  society    Society                @relation(fields: [societyId], references: [id], onDelete: Cascade)
  components BillingRuleComponent[]
  lineItems  BillLineItem[]

  @@index([societyId])
  @@map("billing_rules")
}

model BillingRuleComponent {
  id              String          @id @default(uuid())
  billingRuleId   String
  name            String
  description     String?
  componentType   String
  calculationType CalculationType
  amount          Decimal?        @db.Decimal(10, 2)
  rate            Decimal?        @db.Decimal(10, 4)
  config          Json            @default("{}")
  isActive        Boolean         @default(true)
  order           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  billingRule BillingRule @relation(fields: [billingRuleId], references: [id], onDelete: Cascade)

  @@index([billingRuleId])
  @@map("billing_rule_components")
}

model BillingPeriod {
  id             String              @id @default(uuid())
  societyId      String
  periodYear     Int
  periodMonth    Int
  kind           BillingPeriodKind   @default(REGULAR)
  startDate      DateTime
  endDate        DateTime
  dueDate        DateTime
  status         BillingPeriodStatus @default(DRAFT)
  totalBilled    Decimal             @default(0) @db.Decimal(15, 2)
  totalCollected Decimal             @default(0) @db.Decimal(15, 2)
  totalPending   Decimal             @default(0) @db.Decimal(15, 2)
  notes          String?
  publishedAt    DateTime?
  publishedById  String?
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  society          Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  maintenanceBills MaintenanceBill[]
  statement        MonthlyStatement?

  @@unique([societyId, periodYear, periodMonth])
  @@index([societyId])
  @@map("billing_periods")
}

model MaintenanceBill {
  id                  String   @id @default(uuid())
  societyId           String
  billingPeriodId     String
  flatId              String
  invoiceNumber       String
  flatCode            String
  flatArea            Decimal? @db.Decimal(10, 2)
  flatCategory        String?
  residentCount       Int      @default(0)
  baseAmount          Decimal  @default(0) @db.Decimal(12, 2)
  adjustments         Decimal  @default(0) @db.Decimal(12, 2)
  waterCharges        Decimal  @default(0) @db.Decimal(12, 2)
  lateFee             Decimal  @default(0) @db.Decimal(12, 2)
  otherCharges        Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount          Decimal  @default(0) @db.Decimal(12, 2)
  pendingAmount       Decimal  @default(0) @db.Decimal(12, 2)
  calculationSnapshot Json     @default("{}")
  notes               String?
  dueDate             DateTime
  isPaid              Boolean  @default(false)
  isPublished         Boolean  @default(false)
  // When the late fine was put on this bill — set once, even when the fine is later waived, so a
  // bill is fined at most one time.
  lateFeeAppliedAt    DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  billingPeriod      BillingPeriod       @relation(fields: [billingPeriodId], references: [id])
  flat               Flat                @relation(fields: [flatId], references: [id])
  lineItems          BillLineItem[]
  paymentSubmissions PaymentSubmission[]
  paymentAllocations PaymentAllocation[]

  @@unique([societyId, billingPeriodId, flatId])
  @@unique([societyId, invoiceNumber])
  @@index([societyId])
  @@index([billingPeriodId])
  @@index([flatId])
  @@map("maintenance_bills")
}

model BillLineItem {
  id                String   @id @default(uuid())
  maintenanceBillId String
  billingRuleId     String?
  componentName     String
  componentType     String
  description       String?
  quantity          Decimal? @db.Decimal(10, 4)
  rate              Decimal? @db.Decimal(10, 4)
  amount            Decimal  @db.Decimal(12, 2)
  calculationNote   String?
  createdAt         DateTime @default(now())

  maintenanceBill MaintenanceBill @relation(fields: [maintenanceBillId], references: [id], onDelete: Cascade)
  billingRule     BillingRule?    @relation(fields: [billingRuleId], references: [id])

  @@index([maintenanceBillId])
  @@map("bill_line_items")
}

// ─── WATER BILLING ────────────────────────────────────────────────────────────

model WaterBillingConfig {
  id            String            @id @default(uuid())
  societyId     String
  name          String
  billingModel  WaterBillingModel
  isActive      Boolean           @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  config        Json              @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  society       Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  meterReadings WaterMeterReading[]

  @@index([societyId])
  @@map("water_billing_configs")
}

model WaterMeterReading {
  id               String   @id @default(uuid())
  societyId        String
  flatId           String
  waterConfigId    String?
  billingPeriodId  String?
  readingDate      DateTime
  openingReading   Decimal  @db.Decimal(12, 3)
  closingReading   Decimal  @db.Decimal(12, 3)
  consumption      Decimal  @db.Decimal(12, 3)
  unit             String   @default("KL")
  effectiveRate    Decimal? @db.Decimal(10, 4)
  calculatedAmount Decimal? @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  flat        Flat                @relation(fields: [flatId], references: [id])
  waterConfig WaterBillingConfig? @relation(fields: [waterConfigId], references: [id])

  @@index([societyId])
  @@index([flatId])
  @@map("water_meter_readings")
}

// ─── ACCOUNTS & FUNDS ────────────────────────────────────────────────────────

model Account {
  id                  String      @id @default(uuid())
  societyId           String
  name                String
  accountType         AccountType
  bankName            String?
  accountNumberMasked String?
  ifscCode            String?
  openingBalance      Decimal     @default(0) @db.Decimal(15, 2)
  currentBalance      Decimal     @default(0) @db.Decimal(15, 2)
  isActive            Boolean     @default(true)
  description         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  society       Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  expenses      Expense[]
  salaryRecords SalaryRecord[]
  funds         Fund[]

  @@index([societyId])
  @@map("accounts")
}

model Fund {
  id                   String   @id @default(uuid())
  societyId            String
  name                 String
  description          String?
  accountId            String?
  openingBalance       Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance       Decimal  @default(0) @db.Decimal(15, 2)
  isVisibleToResidents Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  society      Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [accountId], references: [id])
  transactions Transaction[]
  events       Event[]

  @@index([societyId])
  @@map("funds")
}

model Transaction {
  id               String          @id @default(uuid())
  societyId        String
  accountId        String?
  fundId           String?
  transactionType  TransactionType
  amount           Decimal         @db.Decimal(15, 2)
  transactionDate  DateTime
  reference        String?
  description      String
  linkedEntityType String?
  linkedEntityId   String?
  balanceAfter     Decimal         @db.Decimal(15, 2)
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  society Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])
  fund    Fund?    @relation(fields: [fundId], references: [id])

  @@index([societyId])
  @@index([accountId])
  @@index([fundId])
  @@index([transactionDate])
  @@map("transactions")
}

// ─── EXPENSES ─────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id          String   @id @default(uuid())
  societyId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  society  Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([societyId, name])
  @@index([societyId])
  @@map("expense_categories")
}

model Expense {
  id               String        @id @default(uuid())
  societyId        String
  categoryId       String?
  accountId        String?
  vendorPayee      String?
  description      String
  amount           Decimal       @db.Decimal(12, 2)
  expenseDate      DateTime
  invoiceNumber    String?
  referenceNumber  String?
  status           ExpenseStatus @default(PENDING)
  isRecurring      Boolean       @default(false)
  recurringConfig  Json?
  notes            String?
  approvedAt       DateTime?
  paidAt           DateTime?
  createdById      String
  approvedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  // Same generic pattern Document/Transaction already use — set for an
  // Expense generated from Event.recordExpense() ("EVENT" / event.id), so
  // that action is idempotent (one Expense per event, not one per click)
  // without needing a bespoke Event.expenseId column.
  linkedEntityType String?
  linkedEntityId   String?

  society    Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])
  account    Account?         @relation(fields: [accountId], references: [id])
  createdBy  User             @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedBy User?            @relation("ExpenseApprover", fields: [approvedById], references: [id])
  documents  Document[]       @relation("ExpenseDocuments")

  @@index([societyId])
  @@index([linkedEntityType, linkedEntityId])
  @@index([expenseDate])
  @@map("expenses")
}

// ─── SALARIES ─────────────────────────────────────────────────────────────────

