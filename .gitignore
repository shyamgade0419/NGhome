# ─── Node / npm ───────────────────────────────────────────────────────────────
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ─── Environment files (NEVER commit real secrets) ────────────────────────────
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.staging

# ─── Build output ─────────────────────────────────────────────────────────────
**/dist/
**/build/
**/.next/
**/out/

# ─── Expo / React Native ──────────────────────────────────────────────────────
**/.expo/
**/android/app/build/
**/ios/Pods/
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/*.orig.*

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
**/*.swp
**/*.swo
**/.claude/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db

# ─── Test / Coverage ──────────────────────────────────────────────────────────
**/coverage/
**/.nyc_output/

# ─── Uploads / local storage ──────────────────────────────────────────────────
**/uploads/

# ─── TypeScript ───────────────────────────────────────────────────────────────
**/*.tsbuildinfo

# ─── Prisma ───────────────────────────────────────────────────────────────────
**/prisma/migrations/dev.db
**/prisma/*.db

# ─── Misc ─────────────────────────────────────────────────────────────────────
**/*.log
**/*.bak
